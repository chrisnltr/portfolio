# Public site
NUXT_PUBLIC_SITE_URL=

# Resend (server-only)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional alias (same value as NUXT_PUBLIC_TURNSTILE_SITE_KEY):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional analytics / ads (leave empty until ready).
# No scripts are loaded and no events are sent to these platforms while unset.
# Prefer NUXT_PUBLIC_* in Nuxt; VITE_* aliases are also accepted.
# VITE_GA_MEASUREMENT_ID=
# VITE_GOOGLE_ADS_ID=
# VITE_GOOGLE_ADS_CONVERSION_LABEL=
# VITE_META_PIXEL_ID=
# GA4 Measurement ID, e.g. G-XXXXXXXXXX (public; not a secret). Leave empty until configured.
NUXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional alias for NUXT_PUBLIC_GA_MEASUREMENT_ID (same value; do not set both to different IDs).
# NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Google Ads conversion ID, e.g. AW-123456789 (public; not a secret).
NUXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label from the Google Ads “Lead / Kontakt” conversion action
# (paired with NUXT_PUBLIC_GOOGLE_ADS_ID → send_to = AW-…/LABEL).
# Existing name — do not add a parallel *_LEAD_CONVERSION_LABEL variable.
NUXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NUXT_PUBLIC_META_PIXEL_ID=
