# Public site
NUXT_PUBLIC_SITE_URL=

# Resend (server-only)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional alias (same value as NUXT_PUBLIC_TURNSTILE_SITE_KEY):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional analytics / ads (leave empty until ready).
# No scripts are loaded and no events are sent to these platforms while unset.
# Prefer NUXT_PUBLIC_* in Nuxt; VITE_* aliases are also accepted.
# VITE_GA_MEASUREMENT_ID=
# VITE_GOOGLE_ADS_ID=
# VITE_GOOGLE_ADS_CONVERSION_LABEL=
# VITE_META_PIXEL_ID=
NUXT_PUBLIC_GA_MEASUREMENT_ID=
NUXT_PUBLIC_GOOGLE_ADS_ID=
NUXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NUXT_PUBLIC_META_PIXEL_ID=
